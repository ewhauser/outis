---
// Brand lockup: a redaction-bar mark and the "outis" wordmark, matching the favicon.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="brand" aria-label="Outis home">
	<span class="mark" aria-hidden="true"><i></i><i></i></span>
	<span translate="no">outis</span>
</a>

<style>
	.brand {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 21px;
		font-weight: 650;
		letter-spacing: -0.8px;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	.brand:hover {
		text-decoration: none;
	}
	.mark {
		display: grid;
		grid-template-rows: repeat(2, 6px);
		gap: 3px;
		width: 20px;
		margin-right: 4px;
	}
	.mark i {
		background: var(--ink);
		border-radius: 2px;
	}
	.mark i:last-child {
		width: 62%;
		opacity: 0.35;
	}
</style>
